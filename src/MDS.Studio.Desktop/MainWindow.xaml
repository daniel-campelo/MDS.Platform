<Window x:Class="MDS.Studio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MDS Studio 0.0.1" Height="580" Width="940" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel Background="#17202A"><TextBlock Text="MDS STUDIO" Foreground="White" FontSize="20" Margin="20"/>
   <Button Content="Início" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Home_Click"/>
   <Button Content="Projetos" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Projects_Click"/>
   <TextBlock Text="Biblioteca&#x0a;Moldes" Foreground="#BFC9CA" FontSize="15" LineHeight="34" Margin="20,0"/>
   <Button Content="Diagnóstico" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Diagnostics_Click"/>
   <TextBlock Text="Configurações" Foreground="#BFC9CA" FontSize="15" Margin="20,8"/>
  </StackPanel>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
   <StackPanel x:Name="HomePanel"><Border Background="#FFF4CE" Padding="12"><TextBlock Text="🧪 MDS STUDIO — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
   <TextBlock Text="Bem-vindo ao MDS Studio" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Use a sua conta já existente do MDS Core." Foreground="Gray"/>
   <Border x:Name="LoginPanel" BorderBrush="#D7DBDD" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0">
    <StackPanel><TextBlock Text="Entrar com MDS Core" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="A senha é enviada somente ao MDS Core e não é salva pelo Studio." Foreground="Gray" Margin="0,6,0,18"/>
     <TextBlock Text="Endereço do MDS Core"/><TextBox x:Name="CoreUrlInput" Text="http://192.168.7.14:8081/api" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Endereço da API do Studio"/><TextBox x:Name="StudioUrlInput" Text="http://localhost:5000" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Usuário"/><TextBox x:Name="UsernameInput" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Senha"/><PasswordBox x:Name="PasswordInput" Margin="0,5,0,18" Padding="8"/>
     <Button x:Name="SignInButton" Content="Entrar" Width="112" HorizontalAlignment="Left" Padding="14,7" Click="SignIn_Click"/>
    </StackPanel>
   </Border>
   <Border x:Name="SessionPanel" Visibility="Collapsed" Background="#E9F7EF" BorderBrush="#A9DFBF" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0">
    <StackPanel><TextBlock Text="Sessão do MDS Core ativa" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="UserNameText" FontSize="16" Margin="0,12,0,3"/><TextBlock x:Name="RoleText" Foreground="#34495E"/><TextBlock x:Name="PermissionText" TextWrapping="Wrap" Foreground="#34495E" Margin="0,6,0,18"/>
     <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Estado do Studio" FontWeight="SemiBold"/><TextBlock x:Name="StudioStatusText" Margin="0,6,0,2"/><TextBlock x:Name="AgentStatusText" TextWrapping="Wrap" Foreground="#34495E"/></StackPanel></Border>
     <StackPanel Orientation="Horizontal"><Button Content="Atualizar status" Padding="14,7" Click="RefreshStatus_Click"/><Button Content="Sair" Width="112" Margin="12,0,0,0" Padding="14,7" Click="SignOut_Click"/></StackPanel>
    </StackPanel>
   </Border>
   <TextBlock x:Name="StatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   <TextBlock Text="Foundation 0.0.1 · As áreas de produto continuam em desenvolvimento." Foreground="Gray" Margin="0,36,0,0"/>
   </StackPanel>
   <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed"><Border Background="#FFF4CE" Padding="12"><TextBlock Text="🧪 DIAGNÓSTICO — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
    <TextBlock Text="Diagnóstico do MDS Studio" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Consulta somente. Nenhuma alteração é feita nesta tela." Foreground="Gray"/>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0"><StackPanel>
     <TextBlock x:Name="DiagnosticIdentityText" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticApiText" Margin="0,16,0,4"/><TextBlock x:Name="DiagnosticAgentText" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Atualizar diagnóstico" Padding="14,7" Click="RefreshDiagnostics_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock x:Name="DiagnosticStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   </StackPanel>
   <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed"><Border Background="#EAF2F8" Padding="12"><TextBlock Text="PROJETOS — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
    <TextBlock Text="Projetos" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Cadastre um nome e a pasta local do projeto. Nenhum molde, produto ou dado de produção é criado nesta etapa." Foreground="Gray" TextWrapping="Wrap"/>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Novo projeto" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="ProjectNameInput" Padding="8" MaxLength="160"/>
     <TextBlock Text="Pasta local" Margin="0,14,0,4"/><TextBox x:Name="ProjectPathInput" Padding="8" MaxLength="1024"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Criar projeto" Padding="14,7" Click="CreateProject_Click"/><Button Content="Atualizar lista" Margin="12,0,0,0" Padding="14,7" Click="RefreshProjects_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Projetos cadastrados" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/><Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="14"><StackPanel><ComboBox x:Name="ProjectSelector" DisplayMemberPath="Name" MinWidth="360"/><Button Content="Abrir detalhes" Width="120" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6" Click="OpenProject_Click"/></StackPanel></Border>
    <TextBlock x:Name="ProjectsStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
    <StackPanel x:Name="ProjectDetailsPanel" Visibility="Collapsed"><TextBlock Text="Detalhes do projeto" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,8"/>
     <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel>
      <TextBlock x:Name="ProjectDetailsHeading" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="ProjectDetailsNameInput" Padding="8" MaxLength="160"/>
      <TextBlock Text="Pasta local" Margin="0,14,0,4"/><TextBox x:Name="ProjectDetailsPathInput" Padding="8" MaxLength="1024"/>
      <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="ProjectStatusInput" SelectedIndex="0"><ComboBoxItem Content="Ativo"/><ComboBoxItem Content="Em espera"/><ComboBoxItem Content="Concluído"/></ComboBox>
      <TextBlock Text="Descrição" Margin="0,14,0,4"/><TextBox x:Name="ProjectDescriptionInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="72"/>
      <Button Content="Salvar detalhes" Width="120" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="10,6" Click="SaveProjectDetails_Click"/>
     </StackPanel></Border>
     <TextBlock Text="Organização interna" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,4"/><TextBlock Text="Registre etapas ou anotações internas. Isto não cria arquivos, moldes nem produção." Foreground="Gray" TextWrapping="Wrap"/>
     <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="20" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="Título" Margin="0,0,0,4"/><TextBox x:Name="OrganizationTitleInput" Padding="8" MaxLength="160"/>
      <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="OrganizationStatusInput" SelectedIndex="0"><ComboBoxItem Content="Pendente"/><ComboBoxItem Content="Em andamento"/><ComboBoxItem Content="Concluído"/></ComboBox>
      <TextBlock Text="Anotação" Margin="0,14,0,4"/><TextBox x:Name="OrganizationNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="62"/>
      <Button Content="Adicionar item" Width="120" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="10,6" Click="AddOrganizationItem_Click"/>
      <TextBlock Text="Itens registrados" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock x:Name="OrganizationListText" TextWrapping="Wrap"/>
     </StackPanel></Border>
    </StackPanel>
   </StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
