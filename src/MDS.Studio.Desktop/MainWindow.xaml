<Window x:Class="MDS.Studio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MDS Studio 0.0.1" Height="580" Width="940" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel Background="#17202A"><TextBlock Text="MDS STUDIO" Foreground="White" FontSize="20" Margin="20"/>
   <Button Content="Início" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Home_Click"/>
   <Button Content="Projetos" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Projects_Click"/>
   <Button Content="Biblioteca" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Library_Click"/>
   <Button Content="Moldes" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Patterns_Click"/>
   <Button Content="Diagnóstico" HorizontalContentAlignment="Left" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" Padding="20,8" Click="Diagnostics_Click"/>
   <TextBlock Text="Configurações" Foreground="#BFC9CA" FontSize="15" Margin="20,8"/>
  </StackPanel>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
   <StackPanel x:Name="HomePanel"><Border Background="#FFF4CE" Padding="12"><TextBlock Text="🧪 MDS STUDIO — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
   <TextBlock Text="Bem-vindo ao MDS Studio" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Use a sua conta já existente do MDS Core." Foreground="Gray"/>
   <Border x:Name="LoginPanel" BorderBrush="#D7DBDD" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0">
    <StackPanel><TextBlock Text="Entrar com MDS Core" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="A senha é enviada somente ao MDS Core e não é salva pelo Studio." Foreground="Gray" Margin="0,6,0,18"/>
     <TextBlock Text="Endereço do MDS Core"/><TextBox x:Name="CoreUrlInput" Text="http://192.168.7.14:8081/api" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Endereço da API do Studio"/><TextBox x:Name="StudioUrlInput" Text="http://localhost:5000" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Usuário"/><TextBox x:Name="UsernameInput" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Senha"/><PasswordBox x:Name="PasswordInput" Margin="0,5,0,18" Padding="8"/>
     <Button x:Name="SignInButton" Content="Entrar" Width="112" HorizontalAlignment="Left" Padding="14,7" Click="SignIn_Click"/>
    </StackPanel>
   </Border>
   <Border x:Name="SessionPanel" Visibility="Collapsed" Background="#E9F7EF" BorderBrush="#A9DFBF" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0">
    <StackPanel><TextBlock Text="Sessão do MDS Core ativa" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="UserNameText" FontSize="16" Margin="0,12,0,3"/><TextBlock x:Name="RoleText" Foreground="#34495E"/><TextBlock x:Name="PermissionText" TextWrapping="Wrap" Foreground="#34495E" Margin="0,6,0,18"/>
     <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Estado do Studio" FontWeight="SemiBold"/><TextBlock x:Name="StudioStatusText" Margin="0,6,0,2"/><TextBlock x:Name="AgentStatusText" TextWrapping="Wrap" Foreground="#34495E"/></StackPanel></Border>
     <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="Resumo do Studio" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceSummaryText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#34495E"/></StackPanel></Border>
     <StackPanel Orientation="Horizontal"><Button Content="Atualizar status" Padding="14,7" Click="RefreshStatus_Click"/><Button Content="Sair" Width="112" Margin="12,0,0,0" Padding="14,7" Click="SignOut_Click"/></StackPanel>
    </StackPanel>
   </Border>
   <TextBlock x:Name="StatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   <TextBlock Text="Foundation 0.0.1 · As áreas de produto continuam em desenvolvimento." Foreground="Gray" Margin="0,36,0,0"/>
   </StackPanel>
   <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed"><Border Background="#FFF4CE" Padding="12"><TextBlock Text="🧪 DIAGNÓSTICO — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
    <TextBlock Text="Diagnóstico do MDS Studio" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Consulta somente. Nenhuma alteração é feita nesta tela." Foreground="Gray"/>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0"><StackPanel>
     <TextBlock x:Name="DiagnosticIdentityText" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticApiText" Margin="0,16,0,4"/><TextBlock x:Name="DiagnosticAgentText" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Atualizar diagnóstico" Padding="14,7" Click="RefreshDiagnostics_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock x:Name="DiagnosticStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   </StackPanel>
   <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed"><Border Background="#EAF2F8" Padding="12"><TextBlock Text="PROJETOS — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
    <TextBlock Text="Projetos" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Cadastre um nome e a pasta local do projeto. Nenhum molde, produto ou dado de produção é criado nesta etapa." Foreground="Gray" TextWrapping="Wrap"/>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Novo projeto" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="ProjectNameInput" Padding="8" MaxLength="160"/>
     <TextBlock Text="Pasta local" Margin="0,14,0,4"/><TextBox x:Name="ProjectPathInput" Padding="8" MaxLength="1024"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Criar projeto" Padding="14,7" Click="CreateProject_Click"/><Button Content="Atualizar lista" Margin="12,0,0,0" Padding="14,7" Click="RefreshProjects_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Projetos cadastrados" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/><Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="Situação"/><ComboBox x:Name="ProjectFilterStatusInput" SelectedIndex="0" Margin="0,4,0,0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="Ativo"/><ComboBoxItem Content="Em espera"/><ComboBoxItem Content="Concluído"/></ComboBox><Button Content="Aplicar filtro" Width="105" HorizontalAlignment="Left" Margin="0,12,0,12" Padding="10,6" Click="ApplyProjectFilter_Click"/><ComboBox x:Name="ProjectSelector" DisplayMemberPath="Name" MinWidth="360"/><Button Content="Abrir detalhes" Width="120" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6" Click="OpenProject_Click"/></StackPanel></Border>
    <TextBlock x:Name="ProjectsStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
    <StackPanel x:Name="ProjectDetailsPanel" Visibility="Collapsed"><TextBlock Text="Detalhes do projeto" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,8"/>
     <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel>
      <TextBlock x:Name="ProjectDetailsHeading" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="ProjectDetailsNameInput" Padding="8" MaxLength="160"/>
      <TextBlock Text="Pasta local" Margin="0,14,0,4"/><TextBox x:Name="ProjectDetailsPathInput" Padding="8" MaxLength="1024"/>
      <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="ProjectStatusInput" SelectedIndex="0"><ComboBoxItem Content="Ativo"/><ComboBoxItem Content="Em espera"/><ComboBoxItem Content="Concluído"/></ComboBox>
      <TextBlock Text="Descrição" Margin="0,14,0,4"/><TextBox x:Name="ProjectDescriptionInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="72"/>
      <Button Content="Salvar detalhes" Width="120" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="10,6" Click="SaveProjectDetails_Click"/>
     </StackPanel></Border>
     <TextBlock Text="Itens vinculados ao projeto" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/>
     <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="Referências da Biblioteca" FontWeight="SemiBold"/><TextBlock x:Name="ProjectLibraryListText" TextWrapping="Wrap" Margin="0,6,0,16"/><TextBlock Text="Moldes" FontWeight="SemiBold"/><TextBlock x:Name="ProjectPatternsListText" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
     <TextBlock Text="Organização interna" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,4"/><TextBlock Text="Registre etapas ou anotações internas. Isto não cria arquivos, moldes nem produção." Foreground="Gray" TextWrapping="Wrap"/>
     <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="20" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="Título" Margin="0,0,0,4"/><TextBox x:Name="OrganizationTitleInput" Padding="8" MaxLength="160"/>
      <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="OrganizationStatusInput" SelectedIndex="0"><ComboBoxItem Content="Pendente"/><ComboBoxItem Content="Em andamento"/><ComboBoxItem Content="Concluído"/></ComboBox>
      <TextBlock Text="Anotação" Margin="0,14,0,4"/><TextBox x:Name="OrganizationNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="62"/>
      <Button Content="Adicionar item" Width="120" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="10,6" Click="AddOrganizationItem_Click"/>
      <TextBlock Text="Itens registrados" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock x:Name="OrganizationListText" TextWrapping="Wrap"/>
      <TextBlock Text="Editar item interno" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock Text="Item" Margin="0,0,0,4"/><ComboBox x:Name="OrganizationItemSelector" DisplayMemberPath="Title" SelectionChanged="OrganizationItemSelector_SelectionChanged"/><TextBlock Text="Título" Margin="0,14,0,4"/><TextBox x:Name="OrganizationExistingTitleInput" Padding="8" MaxLength="160"/><TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="OrganizationExistingStatusInput" SelectedIndex="0"><ComboBoxItem Content="Pendente"/><ComboBoxItem Content="Em andamento"/><ComboBoxItem Content="Concluído"/></ComboBox><TextBlock Text="Anotação" Margin="0,14,0,4"/><TextBox x:Name="OrganizationExistingNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="62"/><Button Content="Salvar item" Width="115" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6" Click="UpdateOrganizationItem_Click"/>
     </StackPanel></Border>
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="LibraryPanel" Visibility="Collapsed"><Border Background="#FDEDEC" Padding="12"><TextBlock Text="BIBLIOTECA — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
    <TextBlock Text="Biblioteca" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Registre referências por nome, tipo e caminho local. Nesta etapa o Studio não copia, move nem altera seus arquivos." Foreground="Gray" TextWrapping="Wrap"/>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Nova referência" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="LibraryNameInput" Padding="8" MaxLength="260"/>
     <TextBlock Text="Tipo" Margin="0,14,0,4"/><ComboBox x:Name="LibraryTypeInput" SelectedIndex="0"><ComboBoxItem Content="Referência"/><ComboBoxItem Content="Imagem"/><ComboBoxItem Content="Documento"/><ComboBoxItem Content="Outro"/></ComboBox>
     <TextBlock Text="Caminho local" Margin="0,14,0,4"/><TextBox x:Name="LibraryPathInput" Padding="8" MaxLength="1024"/>
     <TextBlock Text="Projeto vinculado (opcional)" Margin="0,14,0,4"/><ComboBox x:Name="LibraryProjectSelector" DisplayMemberPath="Name"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Adicionar à biblioteca" Padding="14,7" Click="CreateLibraryItem_Click"/><Button Content="Atualizar lista" Margin="12,0,0,0" Padding="14,7" Click="RefreshLibrary_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Referências cadastradas" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/><Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="Filtros" FontWeight="SemiBold"/><TextBlock Text="Projeto" Margin="0,12,0,4"/><ComboBox x:Name="LibraryFilterProjectSelector" DisplayMemberPath="Name"/><TextBlock Text="Tipo" Margin="0,12,0,4"/><ComboBox x:Name="LibraryFilterTypeInput" SelectedIndex="0"><ComboBoxItem Content="Todos"/><ComboBoxItem Content="Referência"/><ComboBoxItem Content="Imagem"/><ComboBoxItem Content="Documento"/><ComboBoxItem Content="Outro"/></ComboBox><Button Content="Aplicar filtros" Width="115" HorizontalAlignment="Left" Margin="0,12,0,12" Padding="10,6" Click="ApplyLibraryFilters_Click"/><TextBlock x:Name="LibraryListText" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,20,0,0"><StackPanel><TextBlock Text="Editar referência" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Referência" Margin="0,16,0,4"/><ComboBox x:Name="LibraryItemSelector" DisplayMemberPath="OriginalName" SelectionChanged="LibraryItemSelector_SelectionChanged"/><TextBlock Text="Nome" Margin="0,14,0,4"/><TextBox x:Name="LibraryExistingNameInput" Padding="8" MaxLength="260"/><TextBlock Text="Tipo" Margin="0,14,0,4"/><ComboBox x:Name="LibraryExistingTypeInput" SelectedIndex="0"><ComboBoxItem Content="Referência"/><ComboBoxItem Content="Imagem"/><ComboBoxItem Content="Documento"/><ComboBoxItem Content="Outro"/></ComboBox><TextBlock Text="Caminho local" Margin="0,14,0,4"/><TextBox x:Name="LibraryExistingPathInput" Padding="8" MaxLength="1024"/><TextBlock Text="Projeto vinculado" Margin="0,14,0,4"/><ComboBox x:Name="LibraryExistingProjectSelector" DisplayMemberPath="Name"/><TextBlock Text="Deixe o projeto em branco para retornar o item à Biblioteca geral." Foreground="Gray" Margin="0,6,0,0"/><Button Content="Salvar referência" Width="130" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="10,6" Click="UpdateLibraryLink_Click"/></StackPanel></Border>
    <TextBlock x:Name="LibraryStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   </StackPanel>
   <StackPanel x:Name="PatternsPanel" Visibility="Collapsed"><Border Background="#E8F8F5" Padding="12"><TextBlock Text="MOLDES — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
    <TextBlock Text="Moldes" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Organize moldes por projeto. Nesta etapa não há criação, edição técnica, exportação nem envio de molde." Foreground="Gray" TextWrapping="Wrap"/>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Novo registro de molde" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Projeto" Margin="0,16,0,4"/><ComboBox x:Name="PatternProjectSelector" DisplayMemberPath="Name"/>
     <TextBlock Text="Nome" Margin="0,14,0,4"/><TextBox x:Name="PatternNameInput" Padding="8" MaxLength="160"/>
     <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="PatternStatusInput" SelectedIndex="0"><ComboBoxItem Content="Rascunho"/><ComboBoxItem Content="Em revisão"/><ComboBoxItem Content="Aprovado"/></ComboBox>
     <TextBlock Text="Observações" Margin="0,14,0,4"/><TextBox x:Name="PatternNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="70"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Registrar molde" Padding="14,7" Click="CreatePattern_Click"/><Button Content="Atualizar lista" Margin="12,0,0,0" Padding="14,7" Click="RefreshPatterns_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Moldes registrados" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/>
    <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="14"><StackPanel>
     <TextBlock Text="Filtros" FontWeight="SemiBold"/><TextBlock Text="Projeto" Margin="0,12,0,4"/><ComboBox x:Name="PatternFilterProjectSelector" DisplayMemberPath="Name"/><TextBlock Text="Situação" Margin="0,12,0,4"/><ComboBox x:Name="PatternFilterStatusInput" SelectedIndex="0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="Rascunho"/><ComboBoxItem Content="Em revisão"/><ComboBoxItem Content="Aprovado"/></ComboBox><Button Content="Aplicar filtros" Width="115" HorizontalAlignment="Left" Margin="0,12,0,12" Padding="10,6" Click="ApplyPatternFilters_Click"/><TextBlock x:Name="PatternsListText" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Background="#F8F9F9" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,20,0,0"><StackPanel><TextBlock Text="Editar molde" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Molde" Margin="0,16,0,4"/><ComboBox x:Name="ExistingPatternSelector" DisplayMemberPath="Name" SelectionChanged="ExistingPatternSelector_SelectionChanged"/><TextBlock Text="Projeto" Margin="0,14,0,4"/><ComboBox x:Name="ExistingPatternProjectSelector" DisplayMemberPath="Name"/><TextBlock Text="Nome" Margin="0,14,0,4"/><TextBox x:Name="ExistingPatternNameInput" Padding="8" MaxLength="160"/><TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="ExistingPatternStatusInput" SelectedIndex="0"><ComboBoxItem Content="Rascunho"/><ComboBoxItem Content="Em revisão"/><ComboBoxItem Content="Aprovado"/></ComboBox><TextBlock Text="Observações" Margin="0,14,0,4"/><TextBox x:Name="ExistingPatternNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="70"/><Button Content="Salvar molde" Width="115" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="10,6" Click="UpdatePatternStatus_Click"/></StackPanel></Border>
    <TextBlock x:Name="PatternsStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   </StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
