<Window x:Class="MDS.Studio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MDS Studio 0.0.1" Height="720" Width="1180" WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style x:Key="NavigationButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="20,10"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1E293B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#334155"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="#F5F7FB"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel Background="#0F172A"><TextBlock Text="MDS STUDIO" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="24,28,20,8"/><TextBlock Text="GESTÃO DE CRIAÇÃO" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="24,0,20,24"/>
   <Button Style="{StaticResource NavigationButton}" Content="Início" Click="Home_Click"/>
   <Button Style="{StaticResource NavigationButton}" Content="Projetos" Click="Projects_Click"/>
   <Button Style="{StaticResource NavigationButton}" Content="Biblioteca" Click="Library_Click"/>
   <Button Style="{StaticResource NavigationButton}" Content="Moldes" Click="Patterns_Click"/>
   <Button Style="{StaticResource NavigationButton}" Content="Diagnóstico" Click="Diagnostics_Click"/>
   <Border BorderBrush="#334155" BorderThickness="0,1,0,0" Margin="20,22,20,0" Padding="0,16,0,0"><StackPanel><TextBlock Text="CONFIGURAÇÕES" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"/><Button Style="{StaticResource NavigationButton}" Content="Conexões do Studio" Margin="-20,6,-20,0" Click="Settings_Click"/></StackPanel></Border>
  </StackPanel>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F5F7FB"><StackPanel Margin="42,34,42,42">
   <StackPanel x:Name="HomePanel"><Border Background="#FFF4CE" Padding="12"><TextBlock Text="🧪 MDS STUDIO — HOMOLOGAÇÃO" FontWeight="Bold"/></Border>
   <TextBlock Text="Bem-vindo ao MDS Studio" FontSize="28" Margin="0,28,0,4"/><TextBlock Text="Use a sua conta já existente do MDS Core." Foreground="Gray"/>
   <Border x:Name="LoginPanel" BorderBrush="#D7DBDD" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,28,0,0">
    <StackPanel><TextBlock Text="Entrar com MDS Core" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="A senha é enviada somente ao MDS Core e não é salva pelo Studio." Foreground="Gray" Margin="0,6,0,18"/>
     <TextBlock Text="Endereço do MDS Core"/><TextBox x:Name="CoreUrlInput" Text="http://192.168.7.14:8081/api" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Endereço da API do Studio"/><TextBox x:Name="StudioUrlInput" Text="http://localhost:5000" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Usuário"/><TextBox x:Name="UsernameInput" Margin="0,5,0,14" Padding="8"/>
     <TextBlock Text="Senha"/><PasswordBox x:Name="PasswordInput" Margin="0,5,0,18" Padding="8"/>
     <Button x:Name="SignInButton" Content="Entrar" Width="112" HorizontalAlignment="Left" Padding="14,7" Click="SignIn_Click"/>
    </StackPanel>
   </Border>
   <Border x:Name="SessionPanel" Visibility="Collapsed" Background="White" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,28,0,0">
    <StackPanel><TextBlock Text="Sessão do MDS Core ativa" FontSize="20" FontWeight="SemiBold" Foreground="#0F3D75"/><TextBlock x:Name="UserNameText" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock x:Name="RoleText" Foreground="#475569"/><TextBlock x:Name="PermissionText" TextWrapping="Wrap" Foreground="#475569" Margin="0,6,0,20"/>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="ESTADO DO STUDIO" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="StudioStatusText" Margin="0,10,0,4" FontWeight="SemiBold"/><TextBlock x:Name="AgentStatusText" TextWrapping="Wrap" Foreground="#475569"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="RESUMO DO STUDIO" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceSummaryText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/></StackPanel></Border>
     </Grid>
     <StackPanel Orientation="Horizontal"><Button Content="Atualizar status" Click="RefreshStatus_Click"/><Button Content="Sair" Width="112" Margin="12,0,0,0" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="SignOut_Click"/></StackPanel>
    </StackPanel>
   </Border>
   <TextBlock x:Name="StatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   <TextBlock Text="Foundation 0.0.1 · As áreas de produto continuam em desenvolvimento." Foreground="Gray" Margin="0,36,0,0"/>
   </StackPanel>
   <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed"><Border Background="#FEF3C7" Padding="14" CornerRadius="6"><TextBlock Text="🧪 DIAGNÓSTICO — HOMOLOGAÇÃO" Foreground="#92400E" FontWeight="Bold"/></Border>
    <TextBlock Text="Diagnóstico do MDS Studio" FontSize="30" FontWeight="SemiBold" Foreground="#0F3D75" Margin="0,30,0,4"/><TextBlock Text="Consulta somente. Nenhuma alteração é feita nesta tela." Foreground="#64748B"/>
    <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Estado da conexão" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticIdentityText" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="DiagnosticApiText" Margin="0,16,0,4" Foreground="#334155"/><TextBlock x:Name="DiagnosticAgentText" TextWrapping="Wrap" Foreground="#475569"/>
     <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="Atualizar diagnóstico" Padding="14,7" Click="RefreshDiagnostics_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock x:Name="DiagnosticStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   </StackPanel>
   <StackPanel x:Name="SettingsPanel" Visibility="Collapsed"><Border Background="#E0E7FF" Padding="14" CornerRadius="6"><TextBlock Text="CONFIGURAÇÕES — HOMOLOGAÇÃO" Foreground="#3730A3" FontWeight="Bold"/></Border>
    <TextBlock Text="Conexões do Studio" FontSize="30" FontWeight="SemiBold" Foreground="#0F3D75" Margin="0,30,0,4"/><TextBlock Text="Consulte os endereços usados nesta sessão. Alterações de conexão continuam sendo feitas na tela de entrada." Foreground="#64748B" TextWrapping="Wrap"/>
    <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="MDS Core" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="SettingsCoreUrlText" Margin="0,8,0,18" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="API do Studio" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="SettingsStudioUrlText" Margin="0,8,0,18" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="AMBIENTE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Homologação (Staging)" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold"/>
     <StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Content="Atualizar informações" Padding="14,7" Click="RefreshSettings_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock x:Name="SettingsStatusText" Margin="0,18,0,0" Foreground="#475569" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed"><Border Background="#DBEAFE" Padding="14" CornerRadius="6"><TextBlock Text="PROJETOS — HOMOLOGAÇÃO" Foreground="#1E3A8A" FontWeight="Bold"/></Border>
    <TextBlock Text="Projetos" FontSize="30" FontWeight="SemiBold" Foreground="#0F3D75" Margin="0,30,0,4"/><TextBlock Text="Cadastre um nome e a pasta local do projeto. Nenhum molde, produto ou dado de produção é criado nesta etapa." Foreground="#64748B" TextWrapping="Wrap"/>
    <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Novo projeto" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="ProjectNameInput" Padding="8" MaxLength="160"/>
     <TextBlock Text="Pasta local" Margin="0,14,0,4"/><TextBox x:Name="ProjectPathInput" Padding="8" MaxLength="1024"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Criar projeto" Padding="14,7" Click="CreateProject_Click"/><Button Content="Atualizar lista" Margin="12,0,0,0" Padding="14,7" Click="RefreshProjects_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Projetos cadastrados" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,28,0,10"/><Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Filtrar por situação" Foreground="#475569" FontWeight="SemiBold"/><ComboBox x:Name="ProjectFilterStatusInput" SelectedIndex="0" Margin="0,7,0,0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="Ativo"/><ComboBoxItem Content="Em espera"/><ComboBoxItem Content="Concluído"/></ComboBox><Button Content="Aplicar filtro" Width="115" HorizontalAlignment="Left" Margin="0,14,0,16" Click="ApplyProjectFilter_Click"/><TextBlock Text="Selecionar projeto" Foreground="#475569" FontWeight="SemiBold"/><ComboBox x:Name="ProjectSelector" DisplayMemberPath="Name" MinWidth="360" Margin="0,7,0,0"/><Button Content="Abrir detalhes" Width="130" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenProject_Click"/></StackPanel></Border>
    <TextBlock x:Name="ProjectsStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
    <StackPanel x:Name="ProjectDetailsPanel" Visibility="Collapsed"><TextBlock Text="Detalhes do projeto" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,8"/>
     <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="22"><StackPanel>
      <TextBlock x:Name="ProjectDetailsHeading" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="ProjectDetailsNameInput" Padding="8" MaxLength="160"/>
      <TextBlock Text="Pasta local" Margin="0,14,0,4"/><TextBox x:Name="ProjectDetailsPathInput" Padding="8" MaxLength="1024"/>
      <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="ProjectStatusInput" SelectedIndex="0"><ComboBoxItem Content="Ativo"/><ComboBoxItem Content="Em espera"/><ComboBoxItem Content="Concluído"/></ComboBox>
      <TextBlock Text="Descrição" Margin="0,14,0,4"/><TextBox x:Name="ProjectDescriptionInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="72"/>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Salvar detalhes" Width="120" Padding="10,6" Click="SaveProjectDetails_Click"/><Button Content="Abrir pasta do projeto" Margin="12,0,0,0" Padding="14,7" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="OpenProjectFolder_Click"/></StackPanel>
     </StackPanel></Border>
     <TextBlock Text="Painel visual" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/>
     <Border Background="#F8FAFC" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="REFERÊNCIAS VISUAIS" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Imagens vinculadas ao projeto ou encontradas na pasta local dele." Foreground="#64748B" Margin="0,7,0,14"/><WrapPanel x:Name="ProjectVisualReferencesPanel"/><TextBlock x:Name="ProjectVisualReferencesStatusText" Foreground="#475569" TextWrapping="Wrap"/></StackPanel></Border>
     <TextBlock Text="Itens vinculados ao projeto" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/>
     <Border Background="#F8FAFC" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Referências da Biblioteca" Foreground="#334155" FontWeight="SemiBold"/><TextBlock x:Name="ProjectLibraryListText" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="Abrir na Biblioteca" Width="145" HorizontalAlignment="Left" Padding="12,6" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="OpenProjectLibrary_Click"/><TextBlock Text="Moldes" Foreground="#334155" FontWeight="SemiBold" Margin="0,20,0,0"/><TextBlock x:Name="ProjectPatternsListText" TextWrapping="Wrap" Margin="0,8,0,10"/><Button Content="Abrir em Moldes" Width="135" HorizontalAlignment="Left" Padding="12,6" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="OpenProjectPatterns_Click"/></StackPanel></Border>
     <TextBlock Text="Organização interna" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,4"/><TextBlock Text="Registre etapas ou anotações internas. Isto não cria arquivos, moldes nem produção." Foreground="Gray" TextWrapping="Wrap"/>
     <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Padding="20" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="Título" Margin="0,0,0,4"/><TextBox x:Name="OrganizationTitleInput" Padding="8" MaxLength="160"/>
      <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="OrganizationStatusInput" SelectedIndex="0"><ComboBoxItem Content="Pendente"/><ComboBoxItem Content="Em andamento"/><ComboBoxItem Content="Concluído"/></ComboBox>
      <TextBlock Text="Anotação" Margin="0,14,0,4"/><TextBox x:Name="OrganizationNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="62"/>
      <Button Content="Adicionar item" Width="120" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="10,6" Click="AddOrganizationItem_Click"/>
      <TextBlock Text="Itens registrados" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock x:Name="OrganizationListText" TextWrapping="Wrap"/>
      <TextBlock Text="Editar item interno" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock Text="Item" Margin="0,0,0,4"/><ComboBox x:Name="OrganizationItemSelector" DisplayMemberPath="Title" SelectionChanged="OrganizationItemSelector_SelectionChanged"/><TextBlock Text="Título" Margin="0,14,0,4"/><TextBox x:Name="OrganizationExistingTitleInput" Padding="8" MaxLength="160"/><TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="OrganizationExistingStatusInput" SelectedIndex="0"><ComboBoxItem Content="Pendente"/><ComboBoxItem Content="Em andamento"/><ComboBoxItem Content="Concluído"/></ComboBox><TextBlock Text="Anotação" Margin="0,14,0,4"/><TextBox x:Name="OrganizationExistingNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="62"/><Button Content="Salvar item" Width="115" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6" Click="UpdateOrganizationItem_Click"/>
     </StackPanel></Border>
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="LibraryPanel" Visibility="Collapsed"><Border Background="#FCE7F3" Padding="14" CornerRadius="6"><TextBlock Text="BIBLIOTECA — HOMOLOGAÇÃO" Foreground="#9D174D" FontWeight="Bold"/></Border>
    <TextBlock Text="Biblioteca" FontSize="30" FontWeight="SemiBold" Foreground="#0F3D75" Margin="0,30,0,4"/><TextBlock Text="Registre referências por nome, tipo e caminho local. Nesta etapa o Studio não copia, move nem altera seus arquivos." Foreground="#64748B" TextWrapping="Wrap"/>
    <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Nova referência" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nome" Margin="0,16,0,4"/><TextBox x:Name="LibraryNameInput" Padding="8" MaxLength="260"/>
     <TextBlock Text="Tipo" Margin="0,14,0,4"/><ComboBox x:Name="LibraryTypeInput" SelectedIndex="0"><ComboBoxItem Content="Referência"/><ComboBoxItem Content="Imagem"/><ComboBoxItem Content="Documento"/><ComboBoxItem Content="Outro"/></ComboBox>
     <TextBlock Text="Caminho local" Margin="0,14,0,4"/><TextBox x:Name="LibraryPathInput" Padding="8" MaxLength="1024"/>
     <TextBlock Text="Projeto vinculado (opcional)" Margin="0,14,0,4"/><ComboBox x:Name="LibraryProjectSelector" DisplayMemberPath="Name"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Adicionar à biblioteca" Padding="14,7" Click="CreateLibraryItem_Click"/><Button Content="Atualizar lista" Margin="12,0,0,0" Padding="14,7" Click="RefreshLibrary_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Referências cadastradas" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,28,0,10"/><Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Filtros" Foreground="#475569" FontWeight="SemiBold"/><TextBlock Text="Projeto" Margin="0,12,0,4"/><ComboBox x:Name="LibraryFilterProjectSelector" DisplayMemberPath="Name"/><TextBlock Text="Tipo" Margin="0,12,0,4"/><ComboBox x:Name="LibraryFilterTypeInput" SelectedIndex="0"><ComboBoxItem Content="Todos"/><ComboBoxItem Content="Referência"/><ComboBoxItem Content="Imagem"/><ComboBoxItem Content="Documento"/><ComboBoxItem Content="Outro"/></ComboBox><Button Content="Aplicar filtros" Width="125" HorizontalAlignment="Left" Margin="0,14,0,16" Click="ApplyLibraryFilters_Click"/><TextBlock x:Name="LibraryListText" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,22,0,0"><StackPanel><TextBlock Text="Editar referência" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Text="Referência" Margin="0,16,0,4"/><ComboBox x:Name="LibraryItemSelector" DisplayMemberPath="OriginalName" SelectionChanged="LibraryItemSelector_SelectionChanged"/><TextBlock Text="Nome" Margin="0,14,0,4"/><TextBox x:Name="LibraryExistingNameInput" Padding="8" MaxLength="260"/><TextBlock Text="Tipo" Margin="0,14,0,4"/><ComboBox x:Name="LibraryExistingTypeInput" SelectedIndex="0"><ComboBoxItem Content="Referência"/><ComboBoxItem Content="Imagem"/><ComboBoxItem Content="Documento"/><ComboBoxItem Content="Outro"/></ComboBox><TextBlock Text="Caminho local" Margin="0,14,0,4"/><TextBox x:Name="LibraryExistingPathInput" Padding="8" MaxLength="1024"/><Border x:Name="LibraryPreviewPanel" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="PRÉVIA DA IMAGEM" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/><Image x:Name="LibraryImagePreview" Stretch="Uniform" MaxHeight="240" Margin="0,12,0,8"/><TextBlock x:Name="LibraryPreviewCaptionText" Foreground="#475569" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="Projeto vinculado" Margin="0,14,0,4"/><ComboBox x:Name="LibraryExistingProjectSelector" DisplayMemberPath="Name"/><TextBlock Text="Deixe o projeto em branco para retornar o item à Biblioteca geral." Foreground="#64748B" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Salvar referência" Width="140" Click="UpdateLibraryLink_Click"/><Button Content="Abrir referência" Margin="12,0,0,0" Padding="14,7" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="OpenLibraryFile_Click"/></StackPanel></StackPanel></Border>
    <TextBlock x:Name="LibraryStatusText" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#34495E"/>
   </StackPanel>
   <StackPanel x:Name="PatternsPanel" Visibility="Collapsed"><Border Background="#DCFCE7" Padding="14" CornerRadius="6"><TextBlock Text="MOLDES — HOMOLOGAÇÃO" Foreground="#166534" FontWeight="Bold"/></Border>
    <TextBlock Text="Moldes" FontSize="30" FontWeight="SemiBold" Foreground="#0F3D75" Margin="0,30,0,4"/><TextBlock Text="Organize moldes por projeto. Nesta etapa não há criação, edição técnica, exportação nem envio de molde." Foreground="#64748B" TextWrapping="Wrap"/>
    <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,28,0,0"><StackPanel>
     <TextBlock Text="Novo registro de molde" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Projeto" Margin="0,16,0,4"/><ComboBox x:Name="PatternProjectSelector" DisplayMemberPath="Name"/>
     <TextBlock Text="Nome" Margin="0,14,0,4"/><TextBox x:Name="PatternNameInput" Padding="8" MaxLength="160"/>
     <TextBlock Text="Situação" Margin="0,14,0,4"/><ComboBox x:Name="PatternStatusInput" SelectedIndex="0"><ComboBoxItem Content="Rascunho"/><ComboBoxItem Content="Em revisão"/><ComboBoxItem Content="Aprovado"/></ComboBox>
     <TextBlock Text="Observações" Margin="0,14,0,4"/><TextBox x:Name="PatternNotesInput" Padding="8" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" Height="70"/>
     <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Registrar molde" Padding="14,7" Click="CreatePattern_Click"/><Button Content="Atualizar lista" Margin="12,0,0,0" Padding="14,7" Click="RefreshPatterns_Click"/><Button Content="Voltar ao início" Margin="12,0,0,0" Padding="14,7" Click="Home_Click"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="Moldes registrados" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,28,0,10"/>
    <Border Background="White" BorderBrush="#DCE6F2" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel>
